# Required – your Shopwired REST API key.
SHOPWIRED_API_KEY=your_api_key_here

# Optional – if set, every incoming webhook request must carry a valid
# X-ShopWired-Signature header.  Also required for the initial webhook
# verification handshake that Shopwired performs when you first register
# a webhook endpoint.
SHOPWIRED_WEBHOOK_SECRET=your_webhook_secret_here
